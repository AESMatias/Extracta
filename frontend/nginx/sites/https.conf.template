# Production mode (SITE_DOMAIN set): HTTPS with a Let's Encrypt certificate obtained and renewed
# by the certbot service. ${SITE_DOMAIN} is replaced at start-up; every other $ is Nginx's.

# Port 80: Let's Encrypt's validation files, the health check, and a redirect for everything else.
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${SITE_DOMAIN}$request_uri;
    }
}

# HTTPS for any other name (for example scanners hitting the bare IP): refuse the TLS handshake
# instead of showing them the site with a certificate for the wrong name.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:2m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/site.conf;
}
