# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- LLM provider -----------------------------------------------------------
# Which provider extracts the data: gemini | openai
# (openai requires the optional extra: poetry install --extras openai)
LLM_PROVIDER=gemini
# Model name for the chosen provider.
# Gemini: gemini-3.1-flash-lite (cheapest; shuts down 2027-05-07) or gemini-3.5-flash-lite
# OpenAI: any model that supports structured outputs (see platform.openai.com/docs/models)
LLM_MODEL=gemini-3.1-flash-lite
# Only the key for the selected provider is required.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Database (Supabase PostgreSQL) ----------------------------------------
# Use the Session pooler connection string (Supabase dashboard > Connect).
# The direct connection is IPv6-only and often unreachable from a VPS or Docker.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Queue (Redis inside Docker Compose) ------------------------------------
# "redis" is the Compose service name; Docker's internal DNS resolves it.
CELERY_BROKER_URL=redis://redis:6379/0

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=/tmp_uploads
MAX_UPLOAD_MB=50
