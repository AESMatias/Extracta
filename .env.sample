# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Above each variable: what it is and where to get it.

# =============================================================================
# LLM provider
# =============================================================================
# Which provider extracts the data: gemini | openai
# (openai also requires: docker compose build --build-arg POETRY_EXTRAS=openai)
LLM_PROVIDER=gemini

# Model name for the chosen provider.
#   Gemini: gemini-3.1-flash-lite (cheapest; shuts down 2027-05-07) or gemini-3.5-flash-lite
#   OpenAI: any model that supports structured outputs (platform.openai.com/docs/models)
LLM_MODEL=gemini-3.1-flash-lite

# Only the key of the selected provider is required.
#   Gemini: https://aistudio.google.com/apikey
#   OpenAI: https://platform.openai.com/api-keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# Supabase — database connection (USED by this app)
# =============================================================================
# The app talks to Supabase's PostgreSQL directly through SQLAlchemy.
# Dashboard > "Connect" button (top bar) > "Connection String" tab. There are 3 strings:
#
#   1. Direct connection   postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres
#      IPv6 only: most VPS and Docker networks cannot reach it.
#   2. Session pooler      postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#      IPv4, long-lived connections (web server + Celery worker).  <-- USE THIS ONE
#   3. Transaction pooler  postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
#      For serverless / very short connections. Not for this app.
#
# Then:
#   - change "postgresql://" to "postgresql+psycopg://" (SQLAlchemy driver for psycopg 3)
#   - replace [PASSWORD] with the database password
#     (Project Settings > Database > "Reset database password" if you don't have it)
#   - keep "?sslmode=require" so the connection is encrypted
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# =============================================================================
# Supabase — HTTP API (NOT used by this app today)
# =============================================================================
# Only needed if we later use Supabase Storage, Auth or the REST API (supabase-py).
# Dashboard > Project Settings > API Keys. Uncomment when a step needs them.
#   SUPABASE_URL:             Project URL, https://<project-ref>.supabase.co
#   SUPABASE_PUBLISHABLE_KEY: safe for browsers; limited by Row Level Security (RLS)
#   SUPABASE_SECRET_KEY:      BYPASSES RLS — server side only, never in frontend code
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# =============================================================================
# Queue (Redis inside Docker Compose)
# =============================================================================
# "redis" is the Compose service name; Docker's internal DNS resolves it.
# Database 0 holds the task queue; database 1 holds task results.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Seconds a task result (the extracted JSON) stays in Redis. Ephemeral-mode data exists only
# there and in the browser, so the user must export it before it expires.
RESULT_TTL_SECONDS=3600

# =============================================================================
# Web sessions
# =============================================================================
# Signs the session cookie that ties each browser to the tasks it uploaded, so nobody can read
# someone else's results. REQUIRED, at least 32 characters, never shared. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true in production (HTTPS): the browser then sends the cookie only over encrypted connections.
SESSION_COOKIE_SECURE=false

# =============================================================================
# Uploads
# =============================================================================
# Shared volume between web (writes) and worker (reads, then deletes).
UPLOAD_DIR=/tmp_uploads
# Maximum size per PDF, in megabytes.
MAX_UPLOAD_MB=50
